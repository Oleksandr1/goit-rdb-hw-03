**Завдання 4. Розподіли та потенційні аномалії**
4.1. Розподіл категоріальної колонки job.
q = """
SELECT
    job,
    COUNT(*) AS n_rows,
    ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (), 2) AS pct_rows
FROM hw3_bank_clean
GROUP BY job
ORDER BY n_rows DESC, job
LIMIT 10
"""
pd.read_sql(text(q), engine)
Інтерпретація: (заповнюється після запуску)
4.2. Базова статистика числової колонки balance.
q = """
SELECT
    COUNT(balance) AS n_non_null,
    MIN(balance) AS min_value,
    MAX(balance) AS max_value,
    ROUND(AVG(balance)::NUMERIC, 2) AS avg_value,
    ROUND(STDDEV_SAMP(balance)::NUMERIC, 2) AS sd_value
FROM hw3_bank_clean
"""
pd.read_sql(text(q), engine)
Інтерпретація: (заповнюється після запуску)
4.3. Outlier-check за правилом 3 сигм для balance: кількість викидів і найбільші відхилення.
q = """
WITH stats AS (
    SELECT AVG(balance) AS mean_value, STDDEV_SAMP(balance) AS sd_value
    FROM hw3_bank_clean
    WHERE balance IS NOT NULL
)
SELECT
    COUNT(*) FILTER (WHERE ABS(t.balance - s.mean_value) > 3 * s.sd_value) AS n_outliers,
    COUNT(*) AS total_rows,
    ROUND(COUNT(*) FILTER (WHERE ABS(t.balance - s.mean_value) > 3 * s.sd_value) * 100.0 / COUNT(*), 2) AS pct_outliers
FROM hw3_bank_clean AS t
CROSS JOIN stats AS s
WHERE t.balance IS NOT NULL AND s.sd_value > 0
"""
top_outliers = """
WITH stats AS (
    SELECT AVG(balance) AS mean_value, STDDEV_SAMP(balance) AS sd_value
    FROM hw3_bank_clean
    WHERE balance IS NOT NULL
)
SELECT
    t.client_id, t.age, t.job, t.balance,
    ROUND(((t.balance - s.mean_value) / NULLIF(s.sd_value, 0))::NUMERIC, 2) AS z_score
FROM hw3_bank_clean AS t
CROSS JOIN stats AS s
WHERE t.balance IS NOT NULL
  AND s.sd_value > 0
  AND ABS(t.balance - s.mean_value) > 3 * s.sd_value
ORDER BY ABS(t.balance - s.mean_value) DESC
LIMIT 20
"""
display(pd.read_sql(text(top_outliers), engine))
pd.read_sql(text(q), engine)
