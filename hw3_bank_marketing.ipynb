import pandas as pd
from sqlalchemy import create_engine, text

engine = create_engine(
    "postgresql+psycopg2://postgres:postgres@localhost:5432/hw3_db",
    future=True
)

with engine.connect() as conn:
    print(conn.execute(text("SELECT version()")).scalar_one())
Отримання даних з офіційного джерела через ucimlrepo, збереження в CSV, перевірка форми, порядку колонок і пропусків.
from ucimlrepo import fetch_ucirepo

dataset = fetch_ucirepo(id=222)
df = pd.concat([dataset.data.features, dataset.data.targets], axis=1)

csv_path = '/content/hw3_dataset.csv'
df.to_csv(csv_path, index=False)

print(df.shape)
print(df.columns.tolist())
print(df.isna().sum())
print(df['job'].value_counts(dropna=False))
Staging-таблиця: усі колонки TEXT із суфіксом _raw, порядок як у CSV. Суфікс потрібен також тому, що default є зарезервованим словом SQL.
raw_cols = [c + "_raw" for c in df.columns]
cols_ddl = ",\n    ".join(f"{c} TEXT" for c in raw_cols)

query = f"""
DROP TABLE IF EXISTS hw3_bank_clean CASCADE;
DROP TABLE IF EXISTS hw3_bank_staging CASCADE;

CREATE TABLE hw3_bank_staging (
    {cols_ddl}
);
"""
print(query)
with engine.begin() as conn:
    conn.execute(text(query))
Завантаження CSV через COPY FROM STDIN і контроль кількості рядків.
copy_sql = f"""
COPY hw3_bank_staging ({", ".join(raw_cols)})
FROM STDIN
WITH (FORMAT csv, HEADER true, DELIMITER ',')
"""

raw_conn = engine.raw_connection()
try:
    with raw_conn.cursor() as cur:
        with open(csv_path, 'r', encoding='utf-8', newline='') as file:
            cur.copy_expert(copy_sql, file)
    raw_conn.commit()
finally:
    raw_conn.close()

pd.read_sql(text('SELECT COUNT(*) AS loaded_rows FROM hw3_bank_staging'), engine)
**Завдання 2. Staging і DDL**
Опис колонок: семантика, джерельний формат, вибраний тип і правила очищення.
| Колонка (raw -> clean) | Семантика | Джерельний формат | Тип у clean | Очищення |
|---|---|---|---|---|
| (немає) -> client_id | технічний ключ рядка | відсутній у датасеті | BIGINT IDENTITY, PRIMARY KEY | генерується БД |
| age -> age | вік клієнта, повних років | ціле число як текст | SMALLINT NOT NULL, CHECK 18-120 | TRIM, каст |
| job, marital, education, contact, poutcome | категоріальні ознаки клієнта і контакту | текст; порожнє поле = пропуск у джерелі | TEXT, NULL дозволений | NULLIF(TRIM(x), ''); NULL лишається NULL, штучних значень не підставляємо |
| default, housing, loan -> has_credit_default, has_housing_loan, has_personal_loan | чи є прострочений кредит, іпотека, персональний кредит | yes / no | BOOLEAN | CASE: yes -> TRUE, no -> FALSE, інше -> NULL |
| balance -> balance | середній річний баланс у євро, може бути від'ємним | ціле число як текст | NUMERIC(12, 2) NOT NULL | каст; грошове значення, тому NUMERIC |
| day_of_week -> contact_day | день останнього контакту (діапазон підтвердити клітиною A) | ціле число як текст | SMALLINT NOT NULL, CHECK 1-31 | каст; ім'я змінено, бо значення мають вигляд дня місяця |
| month -> contact_month | місяць останнього контакту | jan ... dec | SMALLINT NOT NULL, CHECK 1-12 | array_position по списку скорочень |
| duration -> duration_sec | тривалість останнього дзвінка в секундах | ціле число як текст | INTEGER NOT NULL, CHECK >= 0 | каст; відомо лише після дзвінка (leakage-ризик) |
| campaign -> campaign | кількість контактів у поточній кампанії | ціле число як текст | SMALLINT NOT NULL, CHECK >= 1 | каст |
| pdays -> pdays | днів від попередньої кампанії; -1 = раніше не контактували | ціле число як текст | INTEGER NOT NULL, CHECK >= -1 | каст; -1 лишаємо як є (спецмаркер) |
| previous -> previous | контактів до цієї кампанії | ціле число як текст | SMALLINT NOT NULL, CHECK >= 0 | каст |
| y -> subscribed | чи оформив клієнт депозит (цільова змінна) | yes / no | BOOLEAN NOT NULL | CASE: yes -> TRUE, no -> FALSE |
Перед створенням clean-таблиці перевіряємо діапазони чисел і набір значень категорій у staging. З цього обґрунтовуємо межі CHECK.
ranges = text("""
SELECT MIN(age_raw::int) AS age_min, MAX(age_raw::int) AS age_max,
       MIN(day_of_week_raw::int) AS day_min, MAX(day_of_week_raw::int) AS day_max,
       MIN(duration_raw::int) AS dur_min, MIN(campaign_raw::int) AS camp_min,
       MIN(pdays_raw::int) AS pdays_min, MIN(previous_raw::int) AS prev_min
FROM hw3_bank_staging
""")
display(pd.read_sql(ranges, engine))

values = text("""
SELECT 'month' AS col, month_raw AS val, COUNT(*) AS n FROM hw3_bank_staging GROUP BY 1, 2
UNION ALL SELECT 'default', default_raw, COUNT(*) FROM hw3_bank_staging GROUP BY 1, 2
UNION ALL SELECT 'housing', housing_raw, COUNT(*) FROM hw3_bank_staging GROUP BY 1, 2
UNION ALL SELECT 'loan', loan_raw, COUNT(*) FROM hw3_bank_staging GROUP BY 1, 2
UNION ALL SELECT 'y', y_raw, COUNT(*) FROM hw3_bank_staging GROUP BY 1, 2
ORDER BY 1, 2
""")
display(pd.read_sql(values, engine))
Висновок з перевірки: (заповнюється після запуску: діапазони age, day, pdays, значення month і yes/no)
ddl = """
DROP TABLE IF EXISTS hw3_bank_clean CASCADE;

CREATE TABLE hw3_bank_clean (
    client_id          BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    age                SMALLINT NOT NULL,
    job                TEXT,
    marital            TEXT,
    education          TEXT,
    has_credit_default BOOLEAN,
    balance            NUMERIC(12, 2) NOT NULL,
    has_housing_loan   BOOLEAN,
    has_personal_loan  BOOLEAN,
    contact            TEXT,
    contact_day        SMALLINT NOT NULL,
    contact_month      SMALLINT NOT NULL,
    duration_sec       INTEGER NOT NULL,
    campaign           SMALLINT NOT NULL,
    pdays              INTEGER NOT NULL,
    previous           SMALLINT NOT NULL,
    poutcome           TEXT,
    subscribed         BOOLEAN NOT NULL,
    CHECK (age BETWEEN 18 AND 120),
    CHECK (contact_day BETWEEN 1 AND 31),
    CHECK (contact_month BETWEEN 1 AND 12),
    CHECK (duration_sec >= 0),
    CHECK (campaign >= 1),
    CHECK (previous >= 0),
    CHECK (pdays >= -1)
);
"""
print(ddl)
with engine.begin() as conn:
    conn.execute(text(ddl))
etl = """
INSERT INTO hw3_bank_clean (
    age, job, marital, education, has_credit_default, balance,
    has_housing_loan, has_personal_loan, contact, contact_day, contact_month,
    duration_sec, campaign, pdays, previous, poutcome, subscribed
)
SELECT
    NULLIF(TRIM(age_raw), '')::SMALLINT,
    NULLIF(TRIM(job_raw), ''),
    NULLIF(TRIM(marital_raw), ''),
    NULLIF(TRIM(education_raw), ''),
    CASE LOWER(TRIM(default_raw)) WHEN 'yes' THEN TRUE WHEN 'no' THEN FALSE END,
    NULLIF(TRIM(balance_raw), '')::NUMERIC(12, 2),
    CASE LOWER(TRIM(housing_raw)) WHEN 'yes' THEN TRUE WHEN 'no' THEN FALSE END,
    CASE LOWER(TRIM(loan_raw)) WHEN 'yes' THEN TRUE WHEN 'no' THEN FALSE END,
    NULLIF(TRIM(contact_raw), ''),
    NULLIF(TRIM(day_of_week_raw), '')::SMALLINT,
    array_position(
        ARRAY['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec'],
        LOWER(TRIM(month_raw))
    )::SMALLINT,
    NULLIF(TRIM(duration_raw), '')::INTEGER,
    NULLIF(TRIM(campaign_raw), '')::SMALLINT,
    NULLIF(TRIM(pdays_raw), '')::INTEGER,
    NULLIF(TRIM(previous_raw), '')::SMALLINT,
    NULLIF(TRIM(poutcome_raw), ''),
    CASE LOWER(TRIM(y_raw)) WHEN 'yes' THEN TRUE WHEN 'no' THEN FALSE END
FROM hw3_bank_staging;
"""
with engine.begin() as conn:
    conn.execute(text(etl))

pd.read_sql(text("SELECT COUNT(*) AS clean_rows FROM hw3_bank_clean"), engine)
