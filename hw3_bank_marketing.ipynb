Висновок: (заповнюється після запуску)
3.2. Дублікати. Business key: age, job, marital, education, balance, contact_day, contact_month, duration_sec, campaign. Природного ключа в датасеті немає, тому перевірка знаходить лише потенційні дублікати.
q = """
SELECT
    COUNT(*) AS total_rows,
    COUNT(DISTINCT (age, job, marital, education, balance, contact_day, contact_month, duration_sec, campaign)) AS distinct_business_keys,
    COUNT(*) - COUNT(DISTINCT (age, job, marital, education, balance, contact_day, contact_month, duration_sec, campaign)) AS duplicate_rows
FROM hw3_bank_clean
"""
dup_groups = """
SELECT age, job, marital, education, balance, contact_day, contact_month, duration_sec, campaign, COUNT(*) AS n_rows
FROM hw3_bank_clean
GROUP BY age, job, marital, education, balance, contact_day, contact_month, duration_sec, campaign
HAVING COUNT(*) > 1
ORDER BY n_rows DESC
LIMIT 10
"""
display(pd.read_sql(text(dup_groups), engine))
pd.read_sql(text(q), engine)
Висновок: (заповнюється після запуску)
3.3. Null-rate у clean (job, education, contact, poutcome) і спецмаркер pdays = -1; окремо перевірка маркерів у staging.
q = """
SELECT
    ROUND(COUNT(*) FILTER (WHERE job IS NULL) * 100.0 / NULLIF(COUNT(*), 0), 2) AS pct_null_job,
    ROUND(COUNT(*) FILTER (WHERE education IS NULL) * 100.0 / NULLIF(COUNT(*), 0), 2) AS pct_null_education,
    ROUND(COUNT(*) FILTER (WHERE contact IS NULL) * 100.0 / NULLIF(COUNT(*), 0), 2) AS pct_null_contact,
    ROUND(COUNT(*) FILTER (WHERE poutcome IS NULL) * 100.0 / NULLIF(COUNT(*), 0), 2) AS pct_null_poutcome,
    ROUND(COUNT(*) FILTER (WHERE pdays = -1) * 100.0 / NULLIF(COUNT(*), 0), 2) AS pct_pdays_minus1,
    COUNT(*) AS total_rows
FROM hw3_bank_clean
"""
markers = """
SELECT
    COUNT(*) FILTER (WHERE job_raw IS NULL OR TRIM(job_raw) = '') AS blank_job,
    COUNT(*) FILTER (WHERE LOWER(TRIM(job_raw)) IN ('unknown', '?')) AS marker_job,
    COUNT(*) FILTER (WHERE education_raw IS NULL OR TRIM(education_raw) = '') AS blank_education,
    COUNT(*) FILTER (WHERE LOWER(TRIM(education_raw)) IN ('unknown', '?')) AS marker_education,
    COUNT(*) FILTER (WHERE contact_raw IS NULL OR TRIM(contact_raw) = '') AS blank_contact,
    COUNT(*) FILTER (WHERE LOWER(TRIM(contact_raw)) IN ('unknown', '?')) AS marker_contact,
    COUNT(*) FILTER (WHERE poutcome_raw IS NULL OR TRIM(poutcome_raw) = '') AS blank_poutcome,
    COUNT(*) FILTER (WHERE LOWER(TRIM(poutcome_raw)) IN ('unknown', '?')) AS marker_poutcome
FROM hw3_bank_staging
"""
display(pd.read_sql(text(markers), engine))
pd.read_sql(text(q), engine)
